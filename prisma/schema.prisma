// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// PhishGuard AI — analysis records.
// Privacy by design: we persist a SHA-256 content hash and a short
// preview only. The full user-supplied message is NEVER stored.
model Analysis {
  id             String   @id @default(cuid())
  contentHash    String   // sha256 of full content (used for dedup caching)
  contentPreview String   // first 160 chars, for history display
  channel        String   // email | sms | text
  riskScore      Int      // 0..100 from deterministic engine
  verdict        String   // safe | suspicious | high | critical
  engineFindings String   // JSON — deterministic engine output
  aiAssessment   String?  // JSON — AI reasoning layer (null if AI unavailable)
  aiUsed         Boolean  @default(false)
  verification   String   // JSON — engine/AI cross-check results
  engineMs       Int      // measured engine duration
  aiMs           Int      // measured AI duration (0 when cached/failed)
  totalMs        Int      // measured total duration
  servedFromCache Boolean @default(false)
  createdAt      DateTime @default(now())

  @@index([contentHash, createdAt])
  @@index([createdAt])
}